Options -MultiViews
RewriteEngine On
RewriteBase /

# 301 redirect www -> non-www (canonical host)
RewriteCond %{HTTP_HOST} ^www\.vulkanspielepoland\.pl$ [NC]
RewriteRule ^(.*)$ https://vulkanspielepoland.pl/$1 [R=301,L]

# 301 redirect /bonus-bez-depozytu/ -> /bonus/ (consolidated page)
RewriteRule ^bonus-bez-depozytu/?$ /bonus/ [R=301,L]
RewriteRule ^bonus-bez-depozytu/(.*)$ /bonus/ [R=301,L]

# Prevent loop — stop if already in /out/
RewriteCond %{REQUEST_URI} ^/out/
RewriteRule ^ - [L]

# Route all requests transparently to out/
RewriteRule ^(.*)$ out/$1 [L]
